<Application x:Class="Doudou.WinUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="SystemAccentColor">#FFF99E1A</Color>
            <Color x:Key="SystemAccentColorLight1">#FFFBB247</Color>
            <Color x:Key="SystemAccentColorLight2">#FFFCC675</Color>
            <Color x:Key="SystemAccentColorLight3">#FFFDDAA3</Color>
            <Color x:Key="SystemAccentColorDark1">#FFE08A0C</Color>
            <Color x:Key="SystemAccentColorDark2">#FFC07200</Color>
            <Color x:Key="SystemAccentColorDark3">#FF8F5500</Color>
            <!-- 强调色按钮上的文字用深蓝，和橙色底对比更清楚 -->
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FF141C2A"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FF141C2A"/>
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FF141C2A"/>
            <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#B3101722"/>
            <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#E6101722"/>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
